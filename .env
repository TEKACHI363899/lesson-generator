# ==============================================================================
# ENGLISH GAMIFIED LESSON STUDIO - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (POSTGRESQL)
# ------------------------------------------------------------------------------
# CACH 1: Dùng DATABASE_URL (Rất tiện cho Neon, Supabase, Render, v.v.)
# Neu ban co chuoi ket noi Cloud, bo comment dong duoi va dien vao:
# DATABASE_URL=postgresql://postgres.xxx:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# CACH 2: Dùng các biến riêng lẻ (Local PostgreSQL hoac Server rieng)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=eng_lesson_db
DB_SSL=false

# Tu dong dong bo bang lan dau (dat true neu muon TypeORM tu tao bang khi start app)
DB_SYNCHRONIZE=false

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_eng_studio_min_32_chars
JWT_EXPIRES_IN=86400s

# ------------------------------------------------------------------------------
# AI MULTIMODAL VISION INTEGRATION (Google Gemini API)
# ------------------------------------------------------------------------------
# Dung de phan tich prompt hoac anh chup man hinh bai hoc
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api
